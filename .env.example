# Server-side settings. Copy to .env and add your own key.
GROQ_API_KEY=
# GROK_API_KEY is also accepted for existing local setups.
QDRANT_URL=http://127.0.0.1:6333
APP_ORIGIN=http://127.0.0.1:3000
UI_INTERNAL_URL=http://127.0.0.1:3000
ENABLE_GENUI=1
# Optional: absolute path or path relative to the project root.
# RAG_RERANKER_DIR=data/models/hub/models--BAAI--bge-reranker-base/snapshots/2cfc18c9415c912f9d8155881c133215df768a70
# Set RAG_API_URL=http://127.0.0.1:8000/ask in frontend/.env.local for a different upstream.

# Optional private local diagnostics with bounded retention.
# RAG_TRACE_DIR=data/app/traces


# Optional LangSmith dashboard. Traces include questions, evidence and model outputs.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=techqa-rag
LANGSMITH_TRACING=true

# Select groq or tokenharbor for generation.
RAG_LLM_PROVIDER=groq
TOKENHARBOR_BASE_URL=https://tokenharbor.ai/v1
TOKENHARBOR_MODEL=deepseek-v4.1-flash:free
TOKENHARBOR_API_KEY=

# TokenHarbor reasoning mode. Change only for a separately labeled comparison.
RAG_THINKING=disabled
